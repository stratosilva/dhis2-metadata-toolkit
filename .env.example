# Copy this file to .env and fill in the real values.
# .env is git-ignored; this template is committed.
#
# Each DHIS2 instance/account pair uses a prefix, and dhis2_env.get_api("PREFIX")
# reads <PREFIX>_URL, <PREFIX>_USERNAME and <PREFIX>_PASSWORD. Only fill in the
# prefixes for the instances you actually use.

# --- SMS gateway (SmartSMSSolutions) ---
# Used by nigeria_sms_manager.py and nigeria_sms_issue_notifier.py
SMS_API_TOKEN=
# Comma-separated numbers alerted when a scheduled job fails
ALERT_PHONE_NUMBERS=

# --- Nigeria NCD, automation account ---
# Used by agg_data_exchange_splitter.py and nigeria_sms_issue_notifier.py
NG_NCD_ROBOT_URL=https://ncd.dhis2nigeria.org.ng/dhis
NG_NCD_ROBOT_USERNAME=
NG_NCD_ROBOT_PASSWORD=

# --- Nigeria NCD, named user account ---
# Used by find_duplicates.py
NG_NCD_ANALYST_URL=https://ncd.dhis2nigeria.org.ng/dhis
NG_NCD_ANALYST_USERNAME=
NG_NCD_ANALYST_PASSWORD=

# --- Ethiopia EPHI staging ---
# Used by get_dashboard_dependancies.py
EPHI_STAGING_URL=https://staging.ephi.gov.et
EPHI_STAGING_USERNAME=
EPHI_STAGING_PASSWORD=

# --- Simple.org sandbox ---
# Used by get_dashboard_dependancies.py main()
SIMPLE_SANDBOX_URL=https://dhis2-sandbox1.simple.org
SIMPLE_SANDBOX_USERNAME=
SIMPLE_SANDBOX_PASSWORD=

# --- Local development instance ---
# Used by reorder_options.py
LOCAL_URL=http://localhost:8080
LOCAL_USERNAME=
LOCAL_PASSWORD=
